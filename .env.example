# Скопируйте в .env и заполните. Файл .env НЕ коммитится в git.

# Ключ Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Модель для ответов: claude-haiku-5-5 (дёшево) | claude-sonnet-5-5 | claude-opus-5-5 (лучшее качество)
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low

# Токен Telegram-бота от @BotFather (необязательно)
TELEGRAM_BOT_TOKEN=

# Пароль для панели аналитики /admin (любая длинная случайная строка)
ADMIN_TOKEN=

# Тонкая настройка RAG
TOP_K=8
MIN_RELEVANCE=0.77
RATE_LIMIT_PER_MIN=20
DAILY_LLM_LIMIT=300
